# parsec.config -- Example config for run_tldmon_parsec_vcu118.sh
#
# Run with:
#   ./run_tldmon_parsec_vcu118.sh parsec.config

# Required
BIN="/test_dir/test_dir/fluidanimate/obj/amd64-linux.gcc-riscv64/fluidanimate"
RUN_SECS=600

# Optional: if unset, WORKDIR defaults to dirname(BIN)
WORKDIR="/test_dir/test_dir/fluidanimate/obj/amd64-linux.gcc-riscv64"

# PARSEC fluidanimate args (command becomes: BIN THREADS FRAMES INPUT_FILE OUTPUT_FILE EXTRA_ARGS)
THREADS=4
FRAMES=1
INPUT_FILE="../../tmp/in_15K.fluid"
OUTPUT_FILE="/tmp/out.out"
EXTRA_ARGS=""

# TLDir monitor thresholds
TLD_THRESH_LO=5
TLD_THRESH_HI=10

# CPU core to pin the workload
CPU_AFF=0

# Sampling window control
SAMPLE_DELAY_SECS=0
SAMPLE_DURATION_SECS=600

# Output files
OUTFILE="tlmon_parsec_fluidanimate_600_5_10_d0_w600.dump"